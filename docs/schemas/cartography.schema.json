{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgotten-tides.com/schemas/cartography.schema.json",
  "title": "Atlas Map Placement File",
  "description": "Schema for design/map/cartography.yaml. Geometry is cartographic; claims cite design/map/CARTOGRAPHIC_BRIEF.md. Densities are never repeated here.",
  "type": "object",
  "required": ["schema_version", "frame", "field", "regions", "sites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v?\\d+\\.\\d+\\.\\d+$" },
    "frame": {
      "type": "object",
      "required": ["units"],
      "additionalProperties": false,
      "properties": {
        "units": { "const": "chart_radius" },
        "angles": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "required": ["blend", "site_sigma", "belt_spread", "radial"],
      "additionalProperties": false,
      "properties": {
        "blend": { "type": "number", "exclusiveMinimum": 0 },
        "site_sigma": { "type": "number", "exclusiveMinimum": 0 },
        "belt_spread": { "type": "number", "minimum": 0 },
        "falloff": { "type": "number", "minimum": 0, "description": "How fast the field eases from the belt's outer value toward the perimeter's; 0 is linear" },
        "radial": {
          "type": "object",
          "required": ["core", "belt", "perimeter"],
          "additionalProperties": false,
          "properties": {
            "core": { "$ref": "#/definitions/locId" },
            "belt": { "$ref": "#/definitions/locId" },
            "perimeter": { "$ref": "#/definitions/locId" }
          }
        },
        "overlays": { "type": "array", "items": { "$ref": "#/definitions/locId" } },
        "arms": {
          "description": "Spiral arms (claim T2): a modulation of the radial base that averages exactly 1 around every circle. The arm count is the named feature's count.",
          "type": "object",
          "required": ["feature", "pitch", "amplitude", "from", "full", "fade", "to"],
          "additionalProperties": false,
          "properties": {
            "feature": { "$ref": "#/definitions/key" },
            "pitch": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 90, "description": "Pitch angle of the logarithmic spiral, in degrees" },
            "amplitude": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Strength through the belt; the lint bounds how far it moves the belt's field along its probe ring" },
            "outer_amplitude": { "type": "number", "minimum": 0, "maximum": 0.6 },
            "phase": { "type": "number", "description": "Rotation of the arms, in degrees" },
            "from": { "type": "number", "exclusiveMinimum": 0 },
            "full": { "type": "number", "minimum": 0 },
            "fade": { "type": "number", "minimum": 0 },
            "to": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "regions": { "type": "array", "items": { "$ref": "#/definitions/region" } },
    "sites": { "type": "array", "items": { "$ref": "#/definitions/site" } },
    "features": { "type": "array", "items": { "$ref": "#/definitions/feature" } },
    "routes": { "type": "array", "items": { "$ref": "#/definitions/route" } },
    "relations": { "type": "array", "items": { "$ref": "#/definitions/relation" } },
    "eras": { "$ref": "#/definitions/eras" },
    "insets": { "type": "array", "items": { "$ref": "#/definitions/inset" } },
    "event_pins": { "type": "array", "items": { "$ref": "#/definitions/eventPin" } },
    "universe": { "$ref": "#/definitions/universe" }
  },
  "definitions": {
    "eventId": { "type": "string", "pattern": "^event-[a-z0-9-]+$" },
    "era": { "enum": ["both", "before", "after"] },
    "plateXY": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "eras": {
      "description": "The era control (Q30, Q31; R15): two discrete states, before and after the breach event. Only states canon ties to the breach are listed, and none carries a figure.",
      "type": "object",
      "required": ["breach", "default", "states"],
      "additionalProperties": false,
      "properties": {
        "breach": { "$ref": "#/definitions/eventId" },
        "default": { "enum": ["before", "after"] },
        "states": { "type": "array", "items": { "$ref": "#/definitions/eraState" } }
      }
    },
    "eraState": {
      "type": "object",
      "required": ["key", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "kind": { "enum": ["sounding", "sleeves", "isopleth-values", "legend-note"] },
        "target": { "$ref": "#/definitions/ref" },
        "within": { "$ref": "#/definitions/ref" },
        "after": { "type": "string" },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "sounding" } } }, "then": { "required": ["target", "after"], "properties": { "after": { "const": "unmeasured" } } } },
        { "if": { "properties": { "kind": { "const": "sleeves" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "kind": { "const": "isopleth-values" } } }, "then": { "required": ["within", "after"], "properties": { "after": { "const": "hidden" } } } },
        { "if": { "properties": { "kind": { "const": "legend-note" } } }, "then": { "required": ["after"] } }
      ]
    },
    "inset": {
      "description": "A Z3 inset plate (Q22-Q29; R12-R14). Element geometry is in plate units: x right and y down from the plate's top-left corner.",
      "type": "object",
      "required": ["key", "site", "title", "plate", "eras", "elements"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "site": { "$ref": "#/definitions/locId" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "plate": {
          "type": "object",
          "required": ["width", "units"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0, "description": "The plate's width in chart units (P.A.)" },
            "units": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
            "title_band": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "eras": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/era" } },
        "misregister": { "$ref": "#/definitions/plateXY" },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/insetElement" } },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      }
    },
    "insetElement": {
      "type": "object",
      "required": ["key", "kind", "tier"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "kind": { "enum": ["plan", "wall", "arc-wall", "room", "door", "shelving", "booths", "housings", "legend", "stair", "station", "hull", "area", "point", "dock", "track", "note", "lintel", "anchor"] },
        "tier": { "enum": ["canon", "drawing-approved", "cartographic", "draft"] },
        "era": { "$ref": "#/definitions/era" },
        "label": { "type": "string" },
        "label_at": { "$ref": "#/definitions/plateXY" },
        "label_align": { "enum": ["start", "middle", "end"] },
        "label_level": { "enum": ["room", "detail", "note"] },
        "anchor": { "$ref": "#/definitions/plateXY" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "at": { "$ref": "#/definitions/plateXY" },
        "a": { "$ref": "#/definitions/plateXY" },
        "b": { "$ref": "#/definitions/plateXY" },
        "c": { "$ref": "#/definitions/plateXY" },
        "r": { "type": "number", "exclusiveMinimum": 0 },
        "r0": { "type": "number", "minimum": 0 },
        "r1": { "type": "number", "exclusiveMinimum": 0 },
        "from": { "type": "number" },
        "to": { "type": "number" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/plateXY" } },
        "divide_at": { "type": "array", "items": { "type": "number" } },
        "aisle": { "type": "number", "exclusiveMinimum": 0 },
        "per_row": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "lost_after": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "erode": { "type": "number", "minimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "spacing": { "type": "number", "exclusiveMinimum": 0 },
        "after_states": { "type": "object", "propertyNames": { "pattern": "^[1-9]\\d*$" }, "additionalProperties": { "enum": ["holds", "reduced", "bound", "lost"] } },
        "style": { "enum": ["solid", "dotted"] },
        "arrow": { "type": "boolean" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "text": { "type": "string" },
        "forgotten_after": { "type": "string" },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["plan", "station", "stair", "booths"] } } }, "then": { "required": ["x", "y", "w", "h"] } },
        { "if": { "properties": { "kind": { "const": "booths" } } }, "then": { "required": ["aisle", "per_row", "count"] } },
        { "if": { "properties": { "kind": { "const": "housings" } } }, "then": { "required": ["c", "r", "from", "to", "size", "count"] } },
        { "if": { "properties": { "kind": { "enum": ["arc-wall", "shelving", "area"] } } }, "then": { "required": ["c", "from", "to"] } },
        { "if": { "properties": { "kind": { "enum": ["wall", "room", "track"] } } }, "then": { "required": ["points"] } },
        { "if": { "properties": { "kind": { "const": "door" } } }, "then": { "required": ["a", "b"] } },
        { "if": { "properties": { "kind": { "enum": ["point", "dock", "note", "lintel", "anchor", "legend"] } } }, "then": { "required": ["at"] } },
        { "if": { "properties": { "kind": { "enum": ["note", "lintel"] } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "kind": { "const": "hull" } } }, "then": { "required": ["c", "r"] } }
      ]
    },
    "eventPin": {
      "description": "An event pin (Q33; R17): on a route, or at a named anchor of an inset.",
      "type": "object",
      "required": ["event"],
      "additionalProperties": false,
      "properties": {
        "event": { "$ref": "#/definitions/eventId" },
        "route": { "$ref": "#/definitions/key" },
        "along": { "type": "number", "minimum": 0, "maximum": 1 },
        "inset": { "$ref": "#/definitions/key" },
        "anchor": { "$ref": "#/definitions/key" },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" }
      },
      "oneOf": [
        { "required": ["route", "along"], "not": { "anyOf": [{ "required": ["inset"] }, { "required": ["anchor"] }] } },
        { "required": ["inset", "anchor"], "not": { "anyOf": [{ "required": ["route"] }, { "required": ["along"] }] } }
      ]
    },
    "universe": {
      "description": "The Z0 scaffold (Q34; R8, R18): unlabeled filaments with no nodes and no gateways around the home galaxy.",
      "type": "object",
      "required": ["extent", "hole", "label"],
      "additionalProperties": false,
      "properties": {
        "extent": { "type": "number", "exclusiveMinimum": 0 },
        "hole": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" }
      }
    },
    "locId": { "type": "string", "pattern": "^loc-\\d{4}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "ref": { "type": "string", "minLength": 1 },
    "polar": {
      "type": "object",
      "required": ["r", "theta"],
      "additionalProperties": false,
      "properties": {
        "r": { "type": "number", "minimum": 0 },
        "theta": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "claims": { "type": "array", "items": { "type": "string", "pattern": "^T\\d+$" } },
    "rules": { "type": "array", "items": { "type": "string", "pattern": "^R\\d+$" } },
    "source": { "type": "string", "pattern": "^[^\\s:#]+(:[1-9]\\d*(-[1-9]\\d*)?|#[A-Za-z0-9_-]+)?$" },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } },
    "tier": { "enum": ["canon", "approved", "cartographic", "draft"] },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "radius"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "disc" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "r": { "type": "number", "minimum": 0 },
            "theta": { "type": "number" }
          }
        },
        {
          "type": "object",
          "required": ["type", "inner", "outer"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "annulus" },
            "inner": { "type": "number", "minimum": 0 },
            "outer": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "r0", "r1", "theta0", "theta1", "half0", "half1"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rift" },
            "r0": { "type": "number", "minimum": 0 },
            "r1": { "type": "number", "exclusiveMinimum": 0 },
            "theta0": { "type": "number" },
            "theta1": { "type": "number" },
            "half0": { "type": "number", "minimum": 0 },
            "half1": { "type": "number", "minimum": 0 },
            "taper": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "pockets" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["r", "theta", "radius"],
                "additionalProperties": false,
                "properties": {
                  "r": { "type": "number", "minimum": 0 },
                  "theta": { "type": "number" },
                  "radius": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "band": {
      "type": "object",
      "required": ["name", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z -]*[a-z]$" },
        "from": { "type": "number", "minimum": 0 },
        "to": { "type": "number", "exclusiveMinimum": 0 },
        "subbands": { "type": "integer", "minimum": 2 }
      }
    },
    "region": {
      "type": "object",
      "required": ["id", "shape"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/locId" },
        "shape": { "$ref": "#/definitions/shape" },
        "bands": { "type": "array", "items": { "$ref": "#/definitions/band" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "label": { "$ref": "#/definitions/polar" },
        "treatment": { "enum": ["core", "belt", "fracture", "ash", "void", "perimeter"] },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "required": ["id", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/locId" },
        "at": { "$ref": "#/definitions/polar" },
        "relation": { "enum": ["inside", "boundary"] },
        "band_position": { "enum": ["mid", "inner-edge", "outer-edge"] },
        "marker": { "enum": ["pin", "existence-doubtful"] },
        "circuit": {
          "type": "object",
          "required": ["radius"],
          "additionalProperties": false,
          "properties": { "radius": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      }
    },
    "sleeve": {
      "type": "object",
      "required": ["number"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "population": { "type": "integer", "minimum": 0 },
        "approximate": { "type": "boolean" },
        "stations": { "type": "integer", "minimum": 0 },
        "city_ships": { "type": "integer", "minimum": 0 },
        "post_breach": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "silo": { "enum": ["held", "reduced-pitch", "lost"] },
            "sleeve": { "enum": ["coherent", "softening"] },
            "note": { "type": "string" }
          }
        },
        "source": { "$ref": "#/definitions/source" }
      },
      "allOf": [
        { "if": { "required": ["population"] }, "then": { "required": ["source"] } },
        { "if": { "required": ["stations"] }, "then": { "required": ["source"] } },
        { "if": { "required": ["post_breach"] }, "then": { "required": ["source"] } }
      ]
    },
    "feature": {
      "type": "object",
      "required": ["key", "label", "kind", "tier"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "label": { "type": "string" },
        "kind": { "enum": ["facility", "sleeves", "historical-site", "edge-line", "texture"] },
        "tier": { "$ref": "#/definitions/tier" },
        "at": { "$ref": "#/definitions/polar" },
        "within": { "$ref": "#/definitions/ref" },
        "along": { "$ref": "#/definitions/ref" },
        "count": { "type": "integer", "minimum": 1 },
        "positions": { "type": "array", "items": { "$ref": "#/definitions/polar" } },
        "sleeves": { "type": "array", "items": { "$ref": "#/definitions/sleeve" } },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "required": ["key", "label", "kind", "tier", "to"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "label": { "type": "string" },
        "kind": { "enum": ["corridor", "tether"] },
        "tier": { "$ref": "#/definitions/tier" },
        "story": { "type": "string", "pattern": "^story-\\d{4}$" },
        "pulls": { "type": "integer", "minimum": 1 },
        "duration": { "type": "string" },
        "origin": { "enum": ["none"] },
        "from": { "$ref": "#/definitions/ref" },
        "to": { "$ref": "#/definitions/ref" },
        "start_within": { "$ref": "#/definitions/ref" },
        "path": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/polar" } },
        "era": { "$ref": "#/definitions/era" },
        "run": { "enum": ["completed", "intended"] },
        "events": { "type": "array", "items": { "$ref": "#/definitions/eventId" } },
        "claims": { "$ref": "#/definitions/claims" },
        "rules": { "$ref": "#/definitions/rules" },
        "sources": { "$ref": "#/definitions/sources" },
        "note": { "type": "string" }
      },
      "allOf": [
        { "if": { "required": ["pulls"] }, "then": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } } },
        { "if": { "required": ["duration"] }, "then": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } } },
        { "if": { "required": ["origin"] }, "then": { "required": ["path", "start_within"] } },
        { "if": { "not": { "required": ["origin"] } }, "then": { "required": ["from"] } }
      ]
    },
    "relation": {
      "type": "object",
      "required": ["type", "a", "b", "claims"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["touches", "disjoint", "near"] },
        "a": { "$ref": "#/definitions/ref" },
        "b": { "$ref": "#/definitions/ref" },
        "claims": { "$ref": "#/definitions/claims" },
        "note": { "type": "string" }
      }
    }
  }
}
